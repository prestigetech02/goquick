# Nginx config for GoQuick landing — static export (aaPanel)
#
# next.config.ts uses: output: "export", trailingSlash: true
# Build output: /www/wwwroot/goquick/landing/out
#
# In aaPanel: set site root to that out/ folder. No PM2. No reverse proxy to Node.

server {
    listen 80;
    listen 443 ssl http2;
    server_name goquickapp.com.ng www.goquickapp.com.ng;

    # aaPanel will manage ssl_certificate lines when you enable Let's Encrypt

    root /www/wwwroot/goquick/landing/out;
    index index.html;

    location / {
        try_files $uri $uri/ $uri/index.html /index.html;
    }

    # Optional: long cache for hashed assets under _next/static
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}

